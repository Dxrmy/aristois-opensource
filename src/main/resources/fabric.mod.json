{
  "schemaVersion": 1,
  "id": "aristois",
  "version": "${version}",
  "name": "Aristois Community Edition",
  "description": "Community-driven open-source continuation of the Aristois Minecraft utility client",
  "authors": [
    "Aristois Community Contributors"
  ],
  "contact": {
    "sources": "https://github.com/your-org/aristois-opensource"
  },
  "license": "MIT",
  "icon": "assets/aristois/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "net.aristois.AristoisMod"
    ],
    "client": [
      "net.aristois.AristoisClient"
    ]
  },
  "mixins": [
    "aristois.mixins.json"
  ],
  "accessWidener": "aristois.accesswidener",
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.20.4",
    "fabric-api": ">=0.91.0"
  }
}